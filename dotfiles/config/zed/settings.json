// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "edit_predictions": {
    "provider": "zed"
  },
  "agent": {
    "notify_when_agent_waiting": "never",
    "tool_permissions": {
      "default": "allow"
    }
  },
  // omp is the harness. Zed talks to it over ACP, so the model, the
  // subscriptions and the tools are all omp's — the "agent" block above only
  // configures Zed's own agent and the inline assistant.
  //
  // The command is the symlink scripts/install-omp.sh maintains. A GUI app
  // gets its PATH from launchd, not from the login shell, so naming the
  // binary rather than an absolute path would leave this working from the
  // terminal and broken from the Dock.
  "agent_servers": {
    "omp": {
      "type": "custom",
      "command": "/usr/local/bin/omp",
      "args": ["acp"],
      "env": {}
    }
  },
  "buffer_font_size": 16,
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false
  },
  "terminal": {
    "detect_venv": {
      "on": {
        "activate_script": "default"
      }
    },
    "line_height": "standard",
    "shell": {
      "program": "nu"
    }
  },
  "theme": "One Dark",
  "ui_font_features": {
    "calt": true
  },
  "ui_font_size": 14,
  "context_servers": {}
}
