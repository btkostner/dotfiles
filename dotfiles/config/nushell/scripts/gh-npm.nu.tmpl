{%- set gh_bin = exec(command="command -v gh || echo gh") | trim -%}
def --env gh-npm-auth [] {
    $env.GH_NPM_TOKEN = (try { ^"{{ gh_bin }}" auth token | str trim } catch { "" })
}

export-env {
    if $nu.is-interactive {
        $env.config.hooks.pre_execution = ($env.config.hooks.pre_execution | append {
            condition: { "GH_NPM_TOKEN" not-in $env }
            code: { gh-npm-auth }
        })
    } else if "GH_NPM_TOKEN" not-in $env {
        gh-npm-auth
    }
}
