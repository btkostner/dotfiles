{%- set uname = exec(command="uname -s") | trim -%}
# Nushell Environment Config File
#
# version = "0.89.0"

use std/util "path add"

# Specifies how environment variables are:
# - converted from a string to a value on Nushell startup (from_string)
# - converted from a value back to a string when running external commands (to_string)
# Note: The conversions happen *after* config.nu is loaded
$env.ENV_CONVERSIONS = {
    "PATH": {
        from_string: { |s| $s | split row (char esep) | path expand --no-symlink }
        to_string: { |v| $v | path expand --no-symlink | str join (char esep) }
    }
    "Path": {
        from_string: { |s| $s | split row (char esep) | path expand --no-symlink }
        to_string: { |v| $v | path expand --no-symlink | str join (char esep) }
    }
}

# Directories to search for scripts when calling source or use
# The default for this is $nu.default-config-dir/scripts
$env.NU_LIB_DIRS = [
    ($nu.default-config-dir | path join 'scripts') # add <nushell-config-dir>/scripts
]

# Directories to search for plugin binaries when calling register
# The default for this is $nu.default-config-dir/plugins
$env.NU_PLUGIN_DIRS = [
    ($nu.default-config-dir | path join 'plugins') # add <nushell-config-dir>/plugins
]

# macOS publishes these through the setXDG LaunchAgent. Nothing does that on
# Linux, and the lines below need them, so fill in the spec defaults.
$env.XDG_CACHE_HOME = ($env | get --optional XDG_CACHE_HOME | default $"($env.HOME)/.cache")
$env.XDG_CONFIG_HOME = ($env | get --optional XDG_CONFIG_HOME | default $"($env.HOME)/.config")
$env.XDG_DATA_HOME = ($env | get --optional XDG_DATA_HOME | default $"($env.HOME)/.local/share")
$env.XDG_STATE_HOME = ($env | get --optional XDG_STATE_HOME | default $"($env.HOME)/.local/state")
$env.AWS_CONFIG_FILE = $"($env.XDG_CONFIG_HOME)/aws/config"
$env.AWS_SHARED_CREDENTIALS_FILE = $"($env.XDG_CONFIG_HOME)/aws/credentials"
$env.AWS_CLI_HISTORY_FILE = $"($env.XDG_STATE_HOME)/aws/cli/history/history.db"
$env.CARGO_HOME = $"($env.XDG_DATA_HOME)/cargo"
$env.RUSTUP_HOME = $"($env.XDG_DATA_HOME)/rustup"
$env.GOPATH = $"($env.XDG_DATA_HOME)/go"
$env.GOMODCACHE = $"($env.XDG_CACHE_HOME)/go/mod"
$env.GOCACHE = $"($env.XDG_CACHE_HOME)/go/build"
$env.GOENV = $"($env.XDG_CONFIG_HOME)/go/env"
$env.NPM_CONFIG_USERCONFIG = $"($env.XDG_CONFIG_HOME)/npm/npmrc"
$env.NPM_CONFIG_CACHE = $"($env.XDG_CACHE_HOME)/npm"
$env.NPM_CONFIG_PREFIX = $"($env.XDG_DATA_HOME)/npm"
$env.KUBECONFIG = $"($env.XDG_CONFIG_HOME)/kube/config"
$env.GH_CONFIG_DIR = $"($env.XDG_CONFIG_HOME)/gh"
$env.TF_CLI_CONFIG_FILE = $"($env.XDG_CONFIG_HOME)/terraform/terraform.rc"
$env.TF_PLUGIN_CACHE_DIR = $"($env.XDG_CACHE_HOME)/terraform/plugin-cache"
$env.PIP_CACHE_DIR = $"($env.XDG_CACHE_HOME)/pip"
$env.PYTHONPYCACHEPREFIX = $"($env.XDG_CACHE_HOME)/python"
$env.NODE_REPL_HISTORY = $"($env.XDG_STATE_HOME)/node/repl_history"
$env.PIP_CONFIG_FILE = $"($env.XDG_CONFIG_HOME)/pip/pip.conf"
$env.UV_CACHE_DIR = $"($env.XDG_CACHE_HOME)/uv"
$env.UV_TOOL_DIR = $"($env.XDG_DATA_HOME)/uv/tools"
$env.UV_PYTHON_INSTALL_DIR = $"($env.XDG_DATA_HOME)/uv/python"
$env.MISE_CONFIG_DIR = $"($env.XDG_CONFIG_HOME)/mise"
$env.MISE_CACHE_DIR = $"($env.XDG_CACHE_HOME)/mise"
$env.MISE_DATA_DIR = $"($env.XDG_DATA_HOME)/mise"
$env.MISE_STATE_DIR = $"($env.XDG_STATE_HOME)/mise"
$env.CLAUDE_CONFIG_DIR = $"($env.XDG_DATA_HOME)/claude-code"
$env.CODEX_HOME = $"($env.XDG_DATA_HOME)/codex"
$env.HEX_HOME = $"($env.XDG_DATA_HOME)/hex"
$env.DENO_DIR = $"($env.XDG_CACHE_HOME)/deno"
$env.BUN_INSTALL_CACHE_DIR = $"($env.XDG_CACHE_HOME)/bun"
$env.YARN_CACHE_FOLDER = $"($env.XDG_CACHE_HOME)/yarn"
$env.WRANGLER_CACHE_DIR = $"($env.XDG_CACHE_HOME)/wrangler"



{% if uname == "Darwin" -%}
# used for mise install erlang

$env.CPPFLAGS = $"($env | get --optional CPPFLAGS | default "") -I/opt/homebrew/opt/unixodbc/include"
$env.LDFLAGS = $"($env | get --optional LDFLAGS | default "") -L/opt/homebrew/opt/unixodbc/lib"
$env.KERL_CONFIGURE_OPTIONS = "--with-odbc=/opt/homebrew/opt/unixodbc --with-ssl=/opt/homebrew/opt/openssl --disable-jit"

{% endif -%}
# Setup pnpm environment

$env.PNPM_HOME = $"($env.XDG_DATA_HOME)/pnpm"

# AI Stuffs
$env.ANTHROPIC_1M_CONTEXT = "true"

# To add entries to PATH (on Windows you might use Path), you can use the following pattern:
# $env.PATH = ($env.PATH | split row (char esep) | prepend '/some/path')

{% if uname == "Darwin" -%}
alias zed = /Applications/Zed.app/Contents/MacOS/cli

# These are system wide and included in `/etc/paths.d/`, but nushell does not
# run this file, so we add them here.
path add "/Applications/Postgres.app/Contents/Versions/latest/bin"

{% endif -%}
# My own custom paths
{% if uname == "Darwin" -%}
path add "/opt/homebrew/bin"
{% endif -%}
path add "/usr/local/bin"
path add ($env.XDG_DATA_HOME | path join "cargo/bin")
path add ($env.GOPATH | path join "bin")
path add ($env.XDG_DATA_HOME | path join "npm/bin")
path add ($env.XDG_DATA_HOME | path join "pnpm")
path add ($env.MISE_DATA_DIR | path join "shims")
path add "~/.local/bin"
